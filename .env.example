# Supabase – get these from: https://supabase.com/dashboard → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-side only (NOT bundled by Vite — no VITE_ prefix).
# Only needed for scripts like seed-vendors.mjs.
# NEVER prefix with VITE_ — that would expose it in the browser bundle.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
